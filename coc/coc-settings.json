{
  "typescript.validate.enable": false,
  "typescript.preferences.quoteStyle": "single",
  "typescript.implementationsCodeLens.enable": false,
  "typescript.referencesCodeLens.enable": false,
  "javascript.validate.enable": false,
  "javascript.implementationsCodeLens.enable": false,
  "javascript.referencesCodeLens.enable": false,
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": true,
  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": true,

  "json.schemas": [],
  "snippets.ultisnips.pythonPrompt": false,
  "json.schemaDownload.trustedDomains": {
    "https://www.schemastore.org": true
  }
  // Disable automatic global fallbacks; force coc-tsserver to look strictly inside the project
  "tsserver.useLocalTsdk": true,
  // The TS 7+ Go-native LSP for modern projects
  "languageserver": {
    "typescript-native": {
      "command": "npx",
      "args": ["tsc", "--lsp", "--stdio"],
      "filetypes": ["typescript", "typescriptreact", "javascript", "javascriptreact"],
      "rootPatterns": ["tsconfig.json", "package.json"]
    }
  },
  "diagnostic.displayByAle": false,
  "diagnostic.enable": true
}
